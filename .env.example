DATABASE_URL=postgresql://okotest:okotest@localhost:5432/okotest

OPENROUTER_API_KEY=enter_your_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=minimax/minimax-m3
EMBEDDING_MODEL=baai/bge-m3
EXTRACTION_MODEL=minimax/minimax-m3
MODEL_FALLBACKS=minimax/minimax-m3:free

EMBEDDING_DIM=1024
VECTOR_MATCH_THRESHOLD=0.82
WRITE_BACK_MIN_CONFIDENCE=0.75
UNTESTED_RECHECK_DAYS=90
DEDUPE_REVIEW_THRESHOLD=0.95
SCAN_RETENTION_DAYS=30
IMAGE_MAX_BYTES=10485760

TRUSTED_SOURCE_DOMAINS=oekotest.de,www.oekotest.de

# Per-scan model calls, used for the boot-time rate-limit assertion (spec §9.1).
MODEL_CALLS_PER_SCAN_MAX=4
# Upstream requests/minute your OpenRouter account actually allows across all
# model calls (20 on :free-only accounts). Scan-rate-limit x calls-per-scan
# must stay under this or the server refuses to start.
UPSTREAM_RPM_ALLOWANCE=20

SCAN_RATE_LIMIT_PER_MIN=4
SCAN_RATE_LIMIT_PER_DAY=500
LIVE_LOOKUP_RATE_LIMIT_PER_DAY=200
READ_RATE_LIMIT_PER_MIN=600

# Comma-separated origins allowed to call this API from a browser (the PHP
# site's JS). "*" is fine for local dev — lock this down in production.
CORS_ALLOWED_ORIGINS=*

# HMAC key used to sign webhook payloads (X-Okotest-Signature, spec §5).
# Required if you use webhook_url — an unset secret signs with an empty key,
# which lets anyone forge a valid signature. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SIGNING_SECRET=
